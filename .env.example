# Local Postgres from docker-compose.yml (port 5433 to avoid clashing with a local Postgres)
DATABASE_URL="postgresql://kyuwing:kyuwing@localhost:5433/kyuwing?schema=public"

# Queue-master PIN. CHANGE THIS before sharing the app.
QUEUE_MASTER_PIN="1234"

# Separate DEVELOPER PIN used for the UI-customization mode. Keep it private and
# different from QUEUE_MASTER_PIN. Leave it unset to disable developer sign-in.
ADMIN_PIN="change-me-developer-pin"

# Random 32+ character string used to sign the queue-master session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Used in calendar links and absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: public org branding. Drop your official logo at public/brand/upbadass-logo.svg
# NEXT_PUBLIC_ORG_NAME="UP BadAss"

# Direct (non-pooled) connection used by Prisma migrations. Supabase: port 5432.
# Required in production; can equal DATABASE_URL when the provider has no pooler.
DIRECT_URL="postgresql://kyuwing:kyuwing@localhost:5433/kyuwing?schema=public"
